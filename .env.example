# ── Bloom environment configuration ─────────────────────────────────────────
# Copy to .env for local development. In Render, set these in the Dashboard
# (or via render.yaml sync:false prompts). NEVER put real secrets in git.

# REQUIRED — PostgreSQL connection string (Render provides this automatically
# for databases declared in render.yaml as DATABASE_URL).
DATABASE_URL=postgres://user:password@localhost:5432/bloom

# REQUIRED in production — long random string used for auth token hashing
# context and cron/admin gating defaults. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used for links in emails).
APP_URL=http://localhost:3000

# OPTIONAL — AI provider (any OpenAI-chat-compatible API; e.g. Grok / x.ai).
# Leave empty to run Bloom in graceful offline companion mode.
AI_PROVIDER_BASE_URL=https://api.x.ai/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=grok-3-mini

# OPTIONAL — transactional email via Resend-compatible API.
# Leave empty to disable email delivery (in-app notifications still work).
EMAIL_API_KEY=
EMAIL_FROM=Bloom <noreply@yourdomain.com>

# OPTIONAL — bearer secret required by /api/cron/reminders (Render Cron Job).
CRON_SECRET=

# OPTIONAL — bearer secret required by /api/admin/diagnostics.
ADMIN_TOKEN=
